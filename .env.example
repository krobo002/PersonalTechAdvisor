NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Local Ollama server (enrichment). Requires `ollama serve` running and the
# chat model pulled first, e.g. `ollama pull llama3.1`.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2:latest
VOYAGE_API_KEY=
RESEND_API_KEY=
# Must be a Resend-verified sending domain, e.g. "Tech Relevance Advisor <digest@yourdomain.com>"
DIGEST_FROM_EMAIL=
CRON_SECRET=
